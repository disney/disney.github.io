{
  "name": "disney-open-source-docs",
  "version": "1.0.0",
  "description": "Documentation site for The Walt Disney Company Open Source Program Office",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate-data && next build",
    "build:static": "npm run generate-data && next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "generate-data": "node scripts/generate-static-data.js"
  },
  "dependencies": {
    "next": "^15.5.21",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@octokit/rest": "^20.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.35",
    "autoprefixer": "^10.4.17"
  }
}

